@echo off
REM Windows batch script to run Spyfall app with environment variables
REM 
REM Copy this file to run_dev.bat and replace with your actual credentials
REM 
REM Usage: run_dev.bat

echo Starting Spyfall app with environment variables...

REM Replace these with your actual credentials
set DRIVE_API_KEY=your_google_drive_api_key_here
set DRIVE_FOLDER_ID=your_drive_folder_id_here

REM Run Flutter with dart-define flags
flutter run ^
  --dart-define=DRIVE_API_KEY=%DRIVE_API_KEY% ^
  --dart-define=DRIVE_FOLDER_ID=%DRIVE_FOLDER_ID%

